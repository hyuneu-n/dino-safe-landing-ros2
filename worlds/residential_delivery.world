      <collision name="c"><geometry><box><size>4.6 4.6 1.3</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>4.6 4.6 1.3</size></box></geometry><material><ambient>0.55 0.55 0.5 1</ambient></material></visual></link></model>
