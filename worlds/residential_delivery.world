      <visual name="v"><geometry><box><size>9 8 36</size></box></geometry><material><ambient>0.46 0.48 0.54 1</ambient></material></visual></link></model>
    <!-- 좌측 더 멀리 → 좌로 swerve -->
    <model name="t_side3_r"><static>true</static><pose>80 14 14 0 0 0</pose><link name="l">
      <collision name="c"><geometry><box><size>8 8 28</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>8 8 28</size></box></geometry><material><ambient>0.5 0.52 0.58 1</ambient></material></visual></link></model>

    <!-- 다운타운 종료 빌딩 -->
    <model name="t_exit_l"><static>true</static><pose>95 12 14 0 0 0</pose><link name="l">
      <collision name="c"><geometry><box><size>10 10 28</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>10 10 28</size></box></geometry><material><ambient>0.5 0.5 0.55 1</ambient></material></visual></link></model>
