<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="residential_delivery">

    <include><uri>model://sun</uri></include>
    <include><uri>model://ground_plane</uri></include>

    <scene><ambient>0.6 0.6 0.6 1</ambient><background>0.7 0.85 0.95 1</background><shadows>false</shadows></scene>
    <physics type="ode"><max_step_size>0.004</max_step_size><real_time_factor>1.0</real_time_factor><real_time_update_rate>250</real_time_update_rate></physics>
    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so"><ros><namespace>/gazebo</namespace></ros><update_rate>50.0</update_rate></plugin>

    <gui><camera name="user_camera"><pose>-160 0 18 0 0.45 0</pose>
      <track_visual><name>delivery_drone</name><static>false</static><use_model_frame>true</use_model_frame><xyz>-10 0 5</xyz><inherit_yaw>true</inherit_yaw></track_visual></camera></gui>

    <!-- ════════ 전 구간 도로 + 중앙선 (드론 비행축 시각화) ════════ -->
    <model name="road"><static>true</static><pose>15 0 0.005 0 0 0</pose><link name="l">
      <visual name="v"><geometry><box><size>340 10 0.02</size></box></geometry><material><ambient>0.28 0.28 0.30 1</ambient><diffuse>0.30 0.30 0.32 1</diffuse></material></visual></link></model>
    <model name="centerline"><static>true</static><pose>15 0 0.02 0 0 0</pose><link name="l">
      <visual name="v"><geometry><box><size>340 0.18 0.01</size></box></geometry><material><ambient>0.9 0.85 0.3 1</ambient></material></visual></link></model>

    <!-- ════════════ ① 외곽 주택가 (x: -150 → -100) — Fuel House ════════════ -->
    <include><name>h_a1</name><uri>model://House 1</uri><pose>-145 14 0 0 0 0</pose></include>
    <include><name>h_a2</name><uri>model://House 3</uri><pose>-145 -14 0 0 0 3.1416</pose></include>
    <include><name>h_a3</name><uri>model://House 3</uri><pose>-120 14 0 0 0 0</pose></include>
    <include><name>h_a4</name><uri>model://House 1</uri><pose>-120 -14 0 0 0 3.1416</pose></include>
    <include><name>h_a5</name><uri>model://House 1</uri><pose>-100 14 0 0 0 0</pose></include>
    <include><name>h_a6</name><uri>model://House 3</uri><pose>-100 -14 0 0 0 3.1416</pose></include>
    <include><name>t_a1</name><uri>model://Pine Tree</uri><pose>-135 8 0 0 0 0</pose></include>
    <include><name>t_a2</name><uri>model://Oak tree</uri><pose>-110 -8 0 0 0 0</pose></include>
    <include><name>lp_a1</name><uri>model://Lamp Post</uri><pose>-130 5 0 0 0 0</pose></include>
    <include><name>car_a1</name><uri>model://Hatchback</uri><pose>-115 5 0 0 0 0</pose></include>

    <!-- ════════════ ② 중밀도 주거 + 저층 빌딩 (x: -90 → -25) ════════════ -->
    <include><name>h_b1</name><uri>model://House 1</uri><pose>-80 14 0 0 0 0</pose></include>
    <include><name>h_b2</name><uri>model://House 3</uri><pose>-80 -14 0 0 0 3.1416</pose></include>
    <!-- 4층짜리 박스 빌딩들 -->
    <model name="midb_1"><static>true</static><pose>-60 13 7 0 0 0</pose><link name="l">
      <collision name="c"><geometry><box><size>10 8 14</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>10 8 14</size></box></geometry><material><ambient>0.65 0.5 0.4 1</ambient><diffuse>0.7 0.55 0.42 1</diffuse></material></visual></link></model>
    <model name="midb_2"><static>true</static><pose>-60 -13 7 0 0 0</pose><link name="l">
      <collision name="c"><geometry><box><size>10 8 14</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>10 8 14</size></box></geometry><material><ambient>0.55 0.55 0.5 1</ambient><diffuse>0.6 0.6 0.55 1</diffuse></material></visual></link></model>
    <model name="midb_3"><static>true</static><pose>-40 13 9 0 0 0</pose><link name="l">
      <collision name="c"><geometry><box><size>11 9 18</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>11 9 18</size></box></geometry>
        <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Bricks</name></script>
          <ambient>0.6 0.42 0.32 1</ambient><diffuse>0.65 0.46 0.34 1</diffuse></material></visual></link></model>
    <model name="midb_4"><static>true</static><pose>-40 -13 9 0 0 0</pose><link name="l">
      <collision name="c"><geometry><box><size>11 9 18</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>11 9 18</size></box></geometry>
        <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Bricks</name></script>
          <ambient>0.5 0.5 0.55 1</ambient><diffuse>0.55 0.55 0.6 1</diffuse></material></visual></link></model>
    <include><name>t_b1</name><uri>model://Oak tree</uri><pose>-65 6 0 0 0 0</pose></include>
    <include><name>lp_b1</name><uri>model://Lamp Post</uri><pose>-50 -5 0 0 0 0</pose></include>
    <include><name>car_b1</name><uri>model://Pickup</uri><pose>-50 6 0 0 0 0</pose></include>

    <!-- ════════════ ③ 다운타운 협곡 (x: -15 → +95) — 박스 타워 ════════════ -->
    <!-- 진입 빌딩 (양쪽 가드) -->
    <model name="t_enter_l"><static>true</static><pose>-10 14 12 0 0 0</pose><link name="l">
      <collision name="c"><geometry><box><size>10 8 24</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>10 8 24</size></box></geometry><material><ambient>0.42 0.42 0.48 1</ambient><diffuse>0.45 0.45 0.5 1</diffuse></material></visual></link></model>
    <model name="t_enter_r"><static>true</static><pose>-10 -14 12 0 0 0</pose><link name="l">
      <collision name="c"><geometry><box><size>10 8 24</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>10 8 24</size></box></geometry><material><ambient>0.48 0.48 0.52 1</ambient><diffuse>0.5 0.5 0.55 1</diffuse></material></visual></link></model>

    <!-- ⭐ SWERVE 포인트 #1 (x=20): tower가 y=0 막음 → 드론 좌/우 선택. 창문 줄 추가 -->
    <model name="t_swerve1"><static>true</static><pose>20 0 22 0 0 0</pose><link name="l">
      <collision name="c"><geometry><box><size>8 8 44</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>8 8 44</size></box></geometry><material><ambient>0.55 0.55 0.6 1</ambient><diffuse>0.58 0.58 0.62 1</diffuse></material></visual>
      <visual name="f1"><pose>0 0 -16 0 0 0</pose><geometry><box><size>8.05 8.05 0.6</size></box></geometry><material><ambient>0.15 0.18 0.25 1</ambient><diffuse>0.2 0.25 0.35 1</diffuse></material></visual>
      <visual name="f2"><pose>0 0 -8 0 0 0</pose><geometry><box><size>8.05 8.05 0.6</size></box></geometry><material><ambient>0.15 0.18 0.25 1</ambient><diffuse>0.2 0.25 0.35 1</diffuse></material></visual>
      <visual name="f3"><pose>0 0 0 0 0 0</pose><geometry><box><size>8.05 8.05 0.6</size></box></geometry><material><ambient>0.15 0.18 0.25 1</ambient><diffuse>0.2 0.25 0.35 1</diffuse></material></visual>
      <visual name="f4"><pose>0 0 8 0 0 0</pose><geometry><box><size>8.05 8.05 0.6</size></box></geometry><material><ambient>0.15 0.18 0.25 1</ambient><diffuse>0.2 0.25 0.35 1</diffuse></material></visual>
      <visual name="f5"><pose>0 0 16 0 0 0</pose><geometry><box><size>8.05 8.05 0.6</size></box></geometry><material><ambient>0.15 0.18 0.25 1</ambient><diffuse>0.2 0.25 0.35 1</diffuse></material></visual></link></model>
    <!-- 옆 빌딩 (좌측이 약간 더 비어있어서 드론이 좌로 swerve 유도) -->
    <model name="t_side1_l"><static>true</static><pose>20 16 18 0 0 0</pose><link name="l">
      <collision name="c"><geometry><box><size>9 8 36</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>9 8 36</size></box></geometry><material><ambient>0.4 0.43 0.5 1</ambient></material></visual></link></model>
    <model name="t_side1_r"><static>true</static><pose>20 -16 25 0 0 0</pose><link name="l">
      <collision name="c"><geometry><box><size>9 8 50</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>9 8 50</size></box></geometry><material><ambient>0.46 0.48 0.54 1</ambient></material></visual></link></model>

    <!-- 사이 통과 구간: tower 양쪽에 (y=±10) → 가운데 비어있음 -->
    <model name="t_pair_l"><static>true</static><pose>35 11 30 0 0 0</pose><link name="l">
      <collision name="c"><geometry><box><size>10 10 60</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>10 10 60</size></box></geometry><material><ambient>0.38 0.4 0.48 1</ambient></material></visual></link></model>
    <model name="t_pair_r"><static>true</static><pose>35 -11 30 0 0 0</pose><link name="l">
      <collision name="c"><geometry><box><size>10 10 60</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>10 10 60</size></box></geometry><material><ambient>0.44 0.46 0.52 1</ambient></material></visual></link></model>

    <!-- ⭐ SWERVE 포인트 #2 (x=50): 다시 tower가 y=0 막음. 이번엔 우측이 더 비어있게 -->
    <model name="t_swerve2"><static>true</static><pose>50 0 18 0 0 0</pose><link name="l">
      <collision name="c"><geometry><box><size>9 9 36</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>9 9 36</size></box></geometry><material><ambient>0.52 0.54 0.6 1</ambient></material></visual>
      <visual name="f1"><pose>0 0 -13 0 0 0</pose><geometry><box><size>9.05 9.05 0.6</size></box></geometry><material><ambient>0.15 0.18 0.25 1</ambient><diffuse>0.22 0.27 0.4 1</diffuse></material></visual>
      <visual name="f2"><pose>0 0 -6 0 0 0</pose><geometry><box><size>9.05 9.05 0.6</size></box></geometry><material><ambient>0.15 0.18 0.25 1</ambient><diffuse>0.22 0.27 0.4 1</diffuse></material></visual>
      <visual name="f3"><pose>0 0 1 0 0 0</pose><geometry><box><size>9.05 9.05 0.6</size></box></geometry><material><ambient>0.15 0.18 0.25 1</ambient><diffuse>0.22 0.27 0.4 1</diffuse></material></visual>
      <visual name="f4"><pose>0 0 8 0 0 0</pose><geometry><box><size>9.05 9.05 0.6</size></box></geometry><material><ambient>0.15 0.18 0.25 1</ambient><diffuse>0.22 0.27 0.4 1</diffuse></material></visual>
      <visual name="f5"><pose>0 0 15 0 0 0</pose><geometry><box><size>9.05 9.05 0.6</size></box></geometry><material><ambient>0.15 0.18 0.25 1</ambient><diffuse>0.22 0.27 0.4 1</diffuse></material></visual></link></model>
    <model name="t_side2_l"><static>true</static><pose>50 14 22 0 0 0</pose><link name="l">
      <collision name="c"><geometry><box><size>10 8 44</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>10 8 44</size></box></geometry><material><ambient>0.45 0.47 0.53 1</ambient></material></visual></link></model>
    <!-- 우측은 더 멀리 → clearance 큼 → 드론 우로 swerve -->
    <model name="t_side2_r"><static>true</static><pose>50 -18 17 0 0 0</pose><link name="l">
      <collision name="c"><geometry><box><size>8 8 34</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>8 8 34</size></box></geometry><material><ambient>0.5 0.52 0.58 1</ambient></material></visual></link></model>

    <!-- 다시 가운데 비는 구간 -->
    <model name="t_pair2_l"><static>true</static><pose>65 12 25 0 0 0</pose><link name="l">
      <collision name="c"><geometry><box><size>11 11 50</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>11 11 50</size></box></geometry><material><ambient>0.42 0.44 0.5 1</ambient></material></visual></link></model>
    <model name="t_pair2_r"><static>true</static><pose>65 -12 25 0 0 0</pose><link name="l">
      <collision name="c"><geometry><box><size>11 11 50</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>11 11 50</size></box></geometry><material><ambient>0.48 0.5 0.56 1</ambient></material></visual></link></model>

    <!-- ⭐ SWERVE 포인트 #3 (x=80): tower 다시 y=0. 좌측이 더 비어있게 -->
    <model name="t_swerve3"><static>true</static><pose>80 0 20 0 0 0</pose><link name="l">
      <collision name="c"><geometry><box><size>8 8 40</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>8 8 40</size></box></geometry><material><ambient>0.55 0.57 0.62 1</ambient></material></visual>
      <visual name="f1"><pose>0 0 -14 0 0 0</pose><geometry><box><size>8.05 8.05 0.6</size></box></geometry><material><ambient>0.15 0.18 0.25 1</ambient><diffuse>0.22 0.28 0.4 1</diffuse></material></visual>
      <visual name="f2"><pose>0 0 -7 0 0 0</pose><geometry><box><size>8.05 8.05 0.6</size></box></geometry><material><ambient>0.15 0.18 0.25 1</ambient><diffuse>0.22 0.28 0.4 1</diffuse></material></visual>
      <visual name="f3"><pose>0 0 0 0 0 0</pose><geometry><box><size>8.05 8.05 0.6</size></box></geometry><material><ambient>0.15 0.18 0.25 1</ambient><diffuse>0.22 0.28 0.4 1</diffuse></material></visual>
      <visual name="f4"><pose>0 0 7 0 0 0</pose><geometry><box><size>8.05 8.05 0.6</size></box></geometry><material><ambient>0.15 0.18 0.25 1</ambient><diffuse>0.22 0.28 0.4 1</diffuse></material></visual>
      <visual name="f5"><pose>0 0 14 0 0 0</pose><geometry><box><size>8.05 8.05 0.6</size></box></geometry><material><ambient>0.15 0.18 0.25 1</ambient><diffuse>0.22 0.28 0.4 1</diffuse></material></visual></link></model>
    <model name="t_side3_l"><static>true</static><pose>80 -14 18 0 0 0</pose><link name="l">
