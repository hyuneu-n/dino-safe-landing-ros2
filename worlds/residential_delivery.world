    <include><name>t_p1</name><uri>model://Pine Tree</uri><pose>118 8 0 0 0 0</pose></include>
    <include><name>t_p2</name><uri>model://Oak tree</uri><pose>126 -8 0 0 0 0</pose></include>

    <!-- ════════════ ⑤ 목적지 주택가 + 착륙 시나리오 (x: 135 → 180) ════════════ -->
    <model name="asphalt_zone"><static>true</static><pose>150 0 0.01 0 0 0</pose><link name="l">
      <visual name="v"><geometry><box><size>34 28 0.02</size></box></geometry>
        <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Road</name></script><ambient>0.32 0.32 0.34 1</ambient></material></visual></link></model>
    <model name="lane_a"><static>true</static><pose>150 3.0 0.03 0 0 0</pose><link name="l"><visual name="v"><geometry><box><size>14 0.14 0.01</size></box></geometry><material><ambient>0.9 0.9 0.9 1</ambient></material></visual></link></model>
    <model name="lane_b"><static>true</static><pose>150 -3.0 0.03 0 0 0</pose><link name="l"><visual name="v"><geometry><box><size>14 0.14 0.01</size></box></geometry><material><ambient>0.9 0.9 0.9 1</ambient></material></visual></link></model>
    <!-- 목적지 주변 주택 (House 1/3만, 4개) -->
    <include><name>h_d1</name><uri>model://House 1</uri><pose>148 17 0 0 0 0</pose></include>
    <include><name>h_d2</name><uri>model://House 3</uri><pose>148 -17 0 0 0 3.1416</pose></include>
    <include><name>h_d3</name><uri>model://House 3</uri><pose>175 12 0 0 0 0</pose></include>
    <include><name>h_d4</name><uri>model://House 1</uri><pose>175 -12 0 0 0 3.1416</pose></include>

    <!-- 후보 ③ 위험: 낮은 차고 지붕 (1.3m 솟음 → depth 거부) -->
