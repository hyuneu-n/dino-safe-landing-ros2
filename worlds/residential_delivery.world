    <!-- ════════════ ④ 다운타운 → 주거 전환 (x: 105 → 125) ════════════ -->
    <model name="midb_5"><static>true</static><pose>110 13 8 0 0 0</pose><link name="l">
      <collision name="c"><geometry><box><size>10 8 16</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>10 8 16</size></box></geometry><material><ambient>0.62 0.5 0.4 1</ambient></material></visual></link></model>
    <model name="midb_6"><static>true</static><pose>110 -13 8 0 0 0</pose><link name="l">
