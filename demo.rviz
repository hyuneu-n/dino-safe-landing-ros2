Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded: ~
      Splitter Ratio: 0.5
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 5
      Plane Cell Count: 40
      Color: 160; 160; 164
      Reference Frame: world
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Names: true
      Marker Scale: 3
    - Class: rviz_default_plugins/Odometry
      Name: DroneOdom
      Enabled: true
      Topic:
        Value: /drone/odom
      Keep: 80
      Position Tolerance: 0.5
      Angle Tolerance: 0.5
      Shape:
        Value: Arrow
        Color: 255; 200; 30
        Shaft Length: 0.6
        Shaft Radius: 0.15
        Head Length: 0.3
        Head Radius: 0.25
    - Class: rviz_default_plugins/PointCloud2
      Name: DownDepthCloud
      Enabled: true
      Topic:
        Value: /drone/down_depth/points
      Style: Points
      Size (Pixels): 3
      Color Transformer: AxisColor
      Axis: Z
    - Class: rviz_default_plugins/MarkerArray
      Name: LandingCandidates
      Enabled: true
      Topic:
        Value: /landing/candidates
      Namespaces:
        {}
    - Class: rviz_default_plugins/Marker
      Name: LandingTarget
      Enabled: true
      Topic:
        Value: /landing/target_marker
    - Class: rviz_default_plugins/Map
      Name: LocalCostmap
      Enabled: true
      Topic:
        Value: /planning/local_costmap
      Color Scheme: costmap
      Alpha: 0.65
    - Class: rviz_default_plugins/MarkerArray
      Name: PlanningCandidates
      Enabled: true
      Topic:
        Value: /planning/candidates
      Namespaces:
        {}
    - Class: rviz_default_plugins/Path
      Name: SelectedLocalPath
      Enabled: true
      Topic:
        Value: /planning/selected_path
      Line Style: Lines
      Line Width: 0.12
      Color: 30; 240; 80
    - Class: rviz_default_plugins/Image
      Name: SafeLandingOverlay
      Enabled: true
      Topic:
        Value: /landing/overlay
    - Class: rviz_default_plugins/Image
      Name: DroneDownCam
      Enabled: true
      Topic:
        Value: /drone/down_cam/image_raw
    - Class: rviz_default_plugins/Image
      Name: ChaseCam
      Enabled: true
      Topic:
        Value: /drone/chase_cam/image_raw
    - Class: rviz_default_plugins/Image
      Name: FrontDepth
      Enabled: true
      Topic:
        Value: /drone/front_depth/depth/image_raw
    - Class: rviz_default_plugins/Image
      Name: IsoCam
      Enabled: true
      Topic:
        Value: /drone/iso_cam/image_raw
    - Class: rviz_default_plugins/Image
      Name: DINO_PCA
      Enabled: false
      Topic:
        Value: /landing/dino_pca
  Global Options:
    Fixed Frame: world
    Background Color: 48; 48; 48
    Frame Rate: 20
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
    - Class: rviz_default_plugins/PublishPoint
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /clicked_point
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 60
      Focal Point:
        X: 50
        Y: 0
        Z: 0
      Pitch: 0.6
      Yaw: 2.6
      Target Frame: world
    Saved: ~
Window Geometry:
  Height: 900
  Width: 1500
  Displays:
    collapsed: false
  SafeLandingOverlay:
    collapsed: false
  DroneDownCam:
    collapsed: false
  ChaseCam:
    collapsed: false
